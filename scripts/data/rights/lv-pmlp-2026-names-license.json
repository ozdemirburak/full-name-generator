{"help": "https://data.gov.lv/dati/api/3/action/help_show?name=package_show", "success": true, "result": {"author": null, "author_email": null, "creator_user_id": "90fab62a-db6b-48e1-8d32-8cde6ab59d11", "frequency": "http://publications.europa.eu/mdr/authority/frequency/ANNUAL_2", "hvd_category": "", "id": "ac246d11-d5d6-445e-a6c7-8f5013460335", "isopen": false, "issued": "2019-07-01", "language": "lv", "license_id": "CC0-1.0", "license_title": "CC0-1.0", "metadata_created": "2019-09-30T13:04:04.858677", "metadata_modified": "2026-07-13T11:01:43.517610", "modified": "2026-07-01", "name": "personu-vardi", "notes": "Datu kopa satur statistisko inform\u0101ciju, cik personas ar konkr\u0113tu personv\u0101rdu un personv\u0101rda kombin\u0101ciju (vair\u0101ki v\u0101rdi) ir iek\u013cautas Fizisko personu re\u0123istr\u0101 (l\u012bdz 2021.06.28. Iedz\u012bvot\u0101ju re\u0123istr\u0101). J\u0101\u0146em v\u0113r\u0101, ka Fizisko personu re\u0123istr\u0101 ir iek\u013cauti ar\u012b \u0101rzemnieku personv\u0101rdi lat\u012b\u0146alfab\u0113tiskaj\u0101 transliter\u0101cij\u0101 atbilsto\u0161i \u0101rvalsts izsniegtajam ce\u013co\u0161anas dokumentam (piem\u0113ram, Nicola, Alex), kas neatbilst latvie\u0161u liter\u0101r\u0101s valodas norm\u0101m.\r\n\r\nNo 2023.10.01. datu kop\u0101 ir ietverta inform\u0101cija par Fizisko personu re\u0123istr\u0101 re\u0123istr\u0113tu personu personv\u0101rdu un personv\u0101rdu kombin\u0101ciju dzimumu (v\u012brietis, sieviete).", "num_resources": 25, "num_tags": 7, "organization": {"id": "f54cc3f1-447d-4d91-9e0d-27c753c99761", "name": "pmlp", "title": "Pilson\u012bbas un migr\u0101cijas lietu p\u0101rvalde", "type": "organization", "description": "Pilson\u012bbas un migr\u0101cijas lietu p\u0101rvalde ir Iek\u0161lietu ministrijas p\u0101rraudz\u012bb\u0101 eso\u0161a tie\u0161\u0101s p\u0101rvaldes iest\u0101de, kuras darb\u012bbas m\u0113r\u0137is ir nodro\u0161in\u0101t valsts interes\u0113m atbilsto\u0161u migr\u0101cijas, patv\u0113ruma, personu tiesisk\u0101 statusa noteik\u0161anas, iedz\u012bvot\u0101ju uzskaites un dokument\u0113\u0161anas procesu vad\u012b\u0161anu un \u012bsteno\u0161anu.", "image_url": "2019-08-08-063328.218528vienkarssbezlaukumargbvLV-32.jpg", "created": "2019-08-08T09:33:28.261560", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "f54cc3f1-447d-4d91-9e0d-27c753c99761", "private": false, "state": "active", "title": "Personu v\u0101rdi", "type": "dataset", "url": null, "version": null, "groups": [{"description": "", "display_name": "Iedz\u012bvot\u0101ji un sabiedr\u012bba", "id": "17a7cad2-8fef-4f91-86b9-1646534a696b", "image_display_url": "", "name": "iedzivotaji-un-sabiedriba", "title": "Iedz\u012bvot\u0101ji un sabiedr\u012bba"}], "resources": [{"cache_last_updated": null, "cache_url": null, "conformsTo": "", "created": "2026-07-13T11:01:04.424338", "datastore_active": true, "description": "V\u0101rdi un v\u0101rdu kombin\u0101cijas, skaits", "format": "CSV", "hash": "", "id": "42202b45-b2bc-439a-b93f-4a6ccf329248", "last_modified": "2026-07-13T11:01:04.284074", "metadata_modified": "2026-07-13T11:01:04.381674", "mimetype": "text/csv", "mimetype_inner": null, "name": "Vardi-20260701.csv", "package_id": "ac246d11-d5d6-445e-a6c7-8f5013460335", "position": 0, "resource_type": null, "size": 2101885, "state": "active", "url": "https://data.gov.lv/dati/dataset/ac246d11-d5d6-445e-a6c7-8f5013460335/resource/42202b45-b2bc-439a-b93f-4a6ccf329248/download/vardi-20260701.csv", "url_type": "upload"}, {"cache_last_updated": null, "cache_url": null, "conformsTo": "", "created": "2026-07-13T11:00:40.630895", "datastore_active": true, "description": "V\u0101rdi un v\u0101rdu kombin\u0101cijas, dzimums, skaits", "format": "CSV", "hash": "", "id": "10f0bb84-dd18-44e9-9a80-dc1515a4b3a9", "last_modified": "2026-07-13T11:00:40.552623", "metadata_modified": "2026-07-13T11:00:40.609516", "mimetype": "text/csv", "mimetype_inner": null, "name":